{
  "name": "meetmyagent-sdk",
  "version": "0.2.0",
  "description": "TypeScript and JavaScript client for the current MeetMyAgent API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studiomeyer-io/meetmyagent-sdk.git"
  },
  "homepage": "https://github.com/studiomeyer-io/meetmyagent-sdk#readme",
  "bugs": {
    "url": "https://github.com/studiomeyer-io/meetmyagent-sdk/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
